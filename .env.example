PORT=4100

# ===== UPS Production — the only external dependency, this tool talks to UPS directly =====
# Always use production endpoints (onlinetools.ups.com), never wwwcie.ups.com (sandbox).
UPS_AUTH_URL=https://onlinetools.ups.com/security/v1/oauth/token
UPS_API_URL=https://onlinetools.ups.com/api/rating/v2409/rate

# ===== DHL Production ===== (NOT /test — that's DHL's sandbox, production has no /test suffix)
DHL_API_URL=https://express.api.dhl.com/mydhlapi

# Optional: pre-fill the form with a default UPS account (still editable in the UI)
DEFAULT_UPS_CLIENT_ID=
DEFAULT_UPS_CLIENT_SECRET=
DEFAULT_UPS_SHIPPER_NUMBER=

# Optional: read-only DB lookup for UPS accounts (all of them, tested automatically)
# and Thai province/postcode autofill. Leave blank to run fully standalone —
# you'll then need to test one account at a time via the fallback manual fields.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
AGENT_DB_NAME=
CONSTANT_DB_NAME=
